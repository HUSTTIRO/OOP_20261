						{
							"_type": "UMLNoteView",
							"_id": "BT3_note_78",
							"_parent": {
								"$ref": "BT3_diag_3"
							},
							"font": "Arial;13;0",
							"parentStyle": false,
							"left": 776,
							"top": 336,
							"width": 470,
							"height": 130,
							"text": "Bất biến (được kiểm tra trong code):\n1. id và fullName không rỗng\n2. baseSalary >= 0; mức tăng lương > 0\n3. primaryLanguage không rỗng; technicalAllowance >= 0\n4. Trong một nhóm không có hai thành viên trùng id\n5. leader luôn thuộc members; không xoá được leader đang giữ\n6. __del__ của ProjectTeam chỉ xoá danh sách, không huỷ Employee"
						}
					]
				},
